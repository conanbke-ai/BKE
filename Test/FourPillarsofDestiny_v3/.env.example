# OpenAI 해설을 사용하지 않으려면 AI_ENABLED=0 또는 API key를 비워 두세요.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
AI_ENABLED=1
AI_MAX_OUTPUT_TOKENS=30000

# 서버
HOST=127.0.0.1
PORT=8787
DEBUG=0

# 공개 배포 안전 모드. 로컬 개발에서는 모두 기본값을 사용해도 됩니다.
PUBLIC_DEPLOYMENT=0
PERSIST_USER_DATA=1
EXTERNAL_SOURCE_ENABLED=1
RATE_LIMIT_ENABLED=1
MAX_REQUEST_BYTES=524288
MAX_GROUP_MEMBERS=20
ANALYSIS_QUEUE_TIMEOUT_SECONDS=2
BROWSER_QUEUE_TIMEOUT_SECONDS=900
BUILD_AUTO_MATCHES=1

# 초대 베타 접근 제어
# Render 공개 베타에서만 BETA_ACCESS_ENABLED=1로 켜고,
# BETA_INVITE_CODE와 SECRET_KEY는 저장소가 아니라 Render Environment에 등록하세요.
BETA_ACCESS_ENABLED=0
BETA_INVITE_CODE=
SECRET_KEY=
BETA_SESSION_DAYS=14
BETA_MAX_ATTEMPTS=8
BETA_ATTEMPT_WINDOW_SECONDS=600

# 영속 볼륨을 사용할 때만 별도 경로를 지정합니다.
STATE_DIR=
DATA_DIR=
BROWSER_PROFILE_DIR=

# 포스텔러 수집 브라우저. 로그인/캡차/접근 제한을 우회하지 않습니다.
HEADLESS=0
FORCETELLER_LOCATION_TEXT=서울특별시, 대한민국
FORCETELLER_LOCATION_ID=1835848

# 첫 실행 자동 추천
# 연령 범위는 사용자 연령대에 따라 코드에서 자동 계산됩니다.
BUILD_AUTO_MATCHES=1
TOP_N=10
IDEAL_TOP_N=5
# 연도별 로컬 상위 후보 몇 명을 세부 원국으로 재확인할지 (정확도/속도 균형)
AUTO_SHORTLIST_PER_YEAR=2
MIN_PARTNER_AGE=20
MIN_VERIFIED_SOURCE_QUALITY=60
RETRY_PARTIAL_FACTS=0

# 과거 프로젝트의 data 폴더를 추가로 재사용해야 할 때만 지정합니다.
# Windows에서는 세미콜론(;)으로 여러 경로를 구분합니다.
# 예: LEGACY_DATA_DIRS=C:\BKE\Test\FourPillarsofDestiny_v2\data
LEGACY_DATA_DIRS=

# 같은 입력의 해설을 강제로 다시 유료 생성하는 기능은 기본 차단입니다.
ALLOW_FORCE_AI_REGENERATION=0
