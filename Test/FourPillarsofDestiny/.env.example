# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6
AI_INCLUDE_IMAGES=0
AI_MAX_OUTPUT_TOKENS=18000
MAX_SOURCE_TEXT_CHARS=900

# 후보 탐색 범위
MAX_YOUNGER_YEARS=5
MAX_OLDER_YEARS=15
FULL_RANGE_TIME_SCAN=1
SCAN_PROGRESS_EVERY_DATES=250

# 최종 TOP 10만 포스텔러 수집
COLLECT_COUNT=10
COLLECTION_RETRY_COUNT=3
BROWSER_RESTART_EVERY=20
POLITE_DELAY_MS=700

# 포스텔러 위치
FIXED_LOCATION_TEXT=서울특별시, 대한민국
FIXED_LOCATION_ID=1835848
FIXED_LOCATION_LONGITUDE=126.9780
STANDARD_MERIDIAN_LONGITUDE=135.0
CANDIDATE_LOCATION_CORRECTION_ENABLED=1
SOLAR_TIME_EXTRA_MINUTES=0

# 포스텔러 파싱·표시
FORCETELLER_SECTION_MAX_LINES=24
FORCETELLER_SECTION_MAX_CHARS=1200
FORCETELLER_MAX_SPECIAL_STARS=20
FORCETELLER_STAR_EXCERPT_CHARS=260
FORCETELLER_AI_SECTION_CHARS=260
FORCETELLER_AI_MAX_SPECIAL_STARS=8
FORCETELLER_AI_STAR_MEANING_CHARS=120
FORCETELLER_AI_STAR_EXCERPT_CHARS=100

# TOP 10 로컬 원국과 포스텔러 4주가 모두 같아야 보고서 생성
STRICT_LOCAL_FORCETELLER_CHART_MATCH=1
